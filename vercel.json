{
  "framework": "vite",
  "installCommand": "npm install && cd frontend && npm install",
  "buildCommand": "cd frontend && VITE_BASE_PATH=/ npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/kozy/manifest.webmanifest",
    {
      "source": "/kozy/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/kozy/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/kozy/registerSW.js",
      "destination": "/registerSW.js"
    },
    {
      "source": "/kozy/workbox-:path*",
      "destination": "/workbox-:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}